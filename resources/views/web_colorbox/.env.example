APP_NAME=Colorbox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Buat dulu database "colorbox_pelanggan" di phpMyAdmin (utf8mb4_unicode_ci)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=colorbox_pelanggan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Email atur ulang kata sandi ditulis ke storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@colorbox.test"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# PIN petugas toko (boleh dibiarkan kosong)
# ------------------------------------------------------------------
# PIN yang diketik kasir ketika memverifikasi pelanggan di toko. Kalau
# dibiarkan kosong, sistem memakai PIN bawaan 246810. Kata sandi akun contoh
# tidak diatur di sini: semuanya memakai tanggal lahir masing-masing.
COLORBOX_STAFF_PIN=

# ------------------------------------------------------------------
# Midtrans Snap (mode sandbox / testing)
# Ambil Server Key dan Client Key di https://dashboard.sandbox.midtrans.com
# ------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------
# Virtual Try On. "preview" = pratinjau lokal di peramban (belum memakai AI).
# "api" = meneruskan ke layanan virtual try-on bila nanti tersedia.
# ------------------------------------------------------------------
# Virtual Try On memakai layanan AI di luar aplikasi.
# Daftar di replicate.com, isi saldo, lalu tempel API token di bawah ini.
# Selama AI_VTO_API_KEY kosong, halaman Virtual Try On berkata apa adanya
# bahwa layanannya belum tersambung, dan tidak menampilkan gambar apa pun.
AI_VTO_DRIVER=replicate
AI_VTO_API_KEY=
AI_VTO_MODEL=cuuupid/idm-vton
AI_VTO_API_URL=
